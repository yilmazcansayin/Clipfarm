{
  "manifest_version": 3,
  "name": "Clipfarm",
  "version": "0.4.0",
  "description": "Her videonun üstüne indirme düğmesi ekler: YouTube, TikTok, Instagram, X, Twitch… tüm videoyu ya da bir aralığı indir, istersen Google Drive'a da kaydet.",
  "action": { "default_popup": "popup.html", "default_title": "Clipfarm" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "scripting", "storage", "downloads", "webRequest", "cookies"],
  "host_permissions": ["<all_urls>"],
  "icons": { "128": "icon128.png" }
}
